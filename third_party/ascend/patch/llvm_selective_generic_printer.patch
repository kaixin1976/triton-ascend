 }
 
+bool OpPrintingFlags::shouldPrintGenericOpForm(
+    StringRef operationName) const {
+  if (printGenericOpFormFlag)
+    return true;
+  for (const std::string &name : genericOpFormNames)
+    if (operationName == name)
+      return true;
+  return false;
+}
